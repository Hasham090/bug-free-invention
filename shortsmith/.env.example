# Required
ANTHROPIC_API_KEY=sk-ant-...

# Model selection (large-v3-turbo is 6x faster with minor accuracy tradeoff)
WHISPER_MODEL=large-v3-turbo
# Set to large-v3 for non-English or low-resource languages:
# WHISPER_MODEL=large-v3

# Compute: cuda, cpu, auto (auto = use GPU if available)
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16

# Optional: wav2vec2 forced alignment for frame-accurate word timestamps
# Requires: pip install shortsmith[whisperx]
USE_WHISPERX=false

# Data directories (relative to shortsmith/)
DATA_DIR=data
UPLOADS_DIR=data/uploads
TRANSCRIPTS_DIR=data/transcripts
CLIPS_DIR=data/clips
THUMBNAILS_DIR=data/thumbnails

# Caption config file
CAPTION_CONFIG=caption_config.json

# FFmpeg hardware acceleration: auto, nvenc, videotoolbox, none
FFMPEG_HW_ACCEL=auto

# Server
HOST=127.0.0.1
PORT=8000

# Claude model
CLAUDE_MODEL=claude-opus-4-7
