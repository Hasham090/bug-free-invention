# ─────────────────────────────────────────────────────────
# StockSense AI — environment variables
# Copy to .env.local and fill in real values.
# The app runs in DEMO MODE when keys are blank — every page
# works, but auth/billing/AI/Shopify calls fall back to mocks.
# ─────────────────────────────────────────────────────────

# Optional: force demo mode even when keys are set
NEXT_PUBLIC_DEMO_MODE=

# ── Clerk (auth) ─────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ── PostgreSQL ───────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/stocksense?schema=public"

# ── OpenAI (AI action engine) ────────────────────────────
OPENAI_API_KEY=

# ── Stripe (subscriptions) ───────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_DEMO_CUSTOMER_ID=

# ── Shopify (store integration) ──────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# ── Amazon SP-API (optional) ─────────────────────────────
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
